# ChimeraX - triada catalitica C58 de FitD (modelo ESMFold del fragmento 1275-1600)
# Numeracion local = global - 1274:  Cys1400=126, His1489=215, Asp1508=234
close
open FitD_1275-1600.pdb
set bgColor white
graphics silhouettes true width 1
lighting soft
windowsize 1200 900
hide atoms
hide cartoons
select (/A:126,215,234 :<7)
cartoon sel
select clear
color #1 #9fb6cd target c
transparency #1 30 target c
show /A:126,215,234 atoms
style /A:126,215,234 stick
size /A:126,215,234 stickRadius 0.2
color /A:126,215,234 & C #2b2b2b
color /A:126,215,234 & N #2166ac
color /A:126,215,234 & O #d6301f
color /A:126,215,234 & S #c9a400
distance /A:126@SG /A:215@ND1
distance /A:215@NE2 /A:234@OD1
distance style color black radius 0.08 dashes 6
label /A:126 residues text "Cys1400" height 0.8 color black offset 0.8,0.8,0
label /A:215 residues text "His1489" height 0.8 color black offset 0.8,0.8,0
label /A:234 residues text "Asp1508" height 0.8 color black offset -3.5,0.8,0
view /A:126,215,234
zoom 0.7
save Figure4A_triada_3D.png width 2400 height 1800 supersample 3
